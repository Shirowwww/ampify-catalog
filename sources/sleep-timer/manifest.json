{
  "$schema": "../../schemas/manifest.schema.json",
  "id": "sleep-timer",
  "name": "Sleep timer (example)",
  "version": "0.1.3",
  "kind": "extension",
  "author": "Shirowwww",
  "description": "Example to learn from. Pauses playback after a delay, set in minutes, then lets you know.",
  "kitApi": "1.0",
  "main": "main.js",
  "permissions": [
    "player.control",
    "notifications"
  ],
  "settings": [
    {"key": "minutes", "label": "Minutes before the pause", "type": "number", "min": 1, "max": 600, "default": 30}
  ],
  "tags": [
    "example",
    "timer",
    "sleep"
  ]
}
